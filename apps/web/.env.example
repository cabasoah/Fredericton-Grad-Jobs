# Copy to .env (or .env.local) and adjust. Only VITE_-prefixed variables are
# exposed to the browser, so never put secrets here.

# Base URL of the jobs API (apps/api). Defaults to http://localhost:4000/api/v1
# when unset. The API's CORS_ORIGIN must allow the origin the web app runs on.
VITE_API_URL=http://localhost:4000/api/v1
