generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// The connection URL comes from prisma.config.ts (DATABASE_URL).
datasource db {
  provider = "postgresql"
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum RemoteType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobSource {
  MANUAL
  GREENHOUSE
  LEVER
}

enum JobStatus {
  OPEN
  CLOSED
}

enum UserRole {
  SEEKER
  EMPLOYER
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

model Company {
  id           String   @id @default(cuid())
  name         String
  description  String?
  website      String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  jobs      Job[]
  employers User[]
}

model Job {
  id          String     @id @default(cuid())
  title       String
  description String
  type        JobType
  remote      RemoteType @default(ONSITE)
  location    String
  salaryMin   Int?
  salaryMax   Int?
  currency    String     @default("CAD")
  tags        String[]   @default([])
  source      JobSource  @default(MANUAL)
  externalId  String?
  externalUrl String?
  status      JobStatus  @default(OPEN)
  postedAt    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  postedById String?
  postedBy   User?   @relation(fields: [postedById], references: [id], onDelete: SetNull)

  applications Application[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([companyId])
}

model User {
  id           String   @id @default(cuid())
  // Stored lowercased; uniqueness is therefore case-insensitive.
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(SEEKER)
  createdAt    DateTime @default(now())

  // Set for EMPLOYER users: the company they post jobs for.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  postedJobs   Job[]
  applications Application[]

  @@index([companyId])
}

// One row per company per ingestion run (npm run ingest or the cron job).
model IngestRun {
  id          String    @id @default(cuid())
  // Shared by all rows written by one run, so a run's rows can be grouped.
  batchId     String
  source      JobSource
  // Board token (Greenhouse) or company slug (Lever).
  company     String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  fetched     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  closed      Int       @default(0)
  // Number of errors (failed fetch, or postings that could not be mapped).
  errors      Int       @default(0)
  // First error message, for debugging.
  errorDetail String?

  @@index([batchId])
  @@index([finishedAt])
}

// Minimal for now; the personal application tracker comes in a later phase.
model Application {
  id        String            @id @default(cuid())
  status    ApplicationStatus @default(SAVED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}
