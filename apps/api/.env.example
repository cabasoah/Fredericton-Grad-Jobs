# Copy to .env and adjust.

# PostgreSQL connection string. Matches the db service in docker-compose.yml
# (host port 5433).
DATABASE_URL=postgresql://jobs:jobs@localhost:5433/jobs?schema=public

# Database for `npm run test:integration`, created and migrated automatically
# and emptied before every test. Defaults to DATABASE_URL's database + "_test".
# TEST_DATABASE_URL=postgresql://jobs:jobs@localhost:5433/jobs_test?schema=public

# Port the API listens on.
PORT=4000

# Origin(s) allowed by CORS, comma-separated. Must match where the web app runs.
CORS_ORIGIN=http://localhost:3000

# Signs session tokens. At least 32 characters. This example value only works
# for local development; the API refuses to start with it in production.
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000

# "true" pulls jobs from the boards in src/ingest/companies.ts every 6 hours
# while the API runs. `npm run ingest` runs it once on demand either way.
INGEST_CRON=false

# Password for the demo employer accounts created by `npm run db:seed`
# (at least 10 characters). Local development only.
SEED_USER_PASSWORD=demo-password-123

# development | test | production. Stack traces are only returned in development.
NODE_ENV=development

# Number of reverse proxies in front of the API, so rate limits see each
# client's real IP. 0 locally; 1 behind nginx in docker compose; set it to
# the platform's proxy count when deployed.
TRUST_PROXY=0

# Session cookie Secure flag (HTTPS only). Unset = true in production,
# false otherwise. Only set "false" for a production build on plain-HTTP
# localhost (docker compose does this).
# COOKIE_SECURE=false
